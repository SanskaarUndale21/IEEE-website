# Google Sheets integration for the website forms
# Copy to .env.local and fill in. Without these the forms fall back to data/*.txt

GOOGLE_SHEETS_ID=your_spreadsheet_id_here
GOOGLE_SERVICE_ACCOUNT_EMAIL=ieee-website@your-project.iam.gserviceaccount.com
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIE...\n-----END PRIVATE KEY-----\n"

# Optional: override the tab names (created automatically on first submission)
GOOGLE_SHEETS_MEMBERS_TAB=Memberships
GOOGLE_SHEETS_QUERIES_TAB=Queries

# ── Supabase (server only, never prefix with NEXT_PUBLIC_) ──
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# ── Admin panel (generate with: node scripts/setup-admin.mjs) ──
ADMIN_IEEE_ID=101132497
ADMIN_ROUTE_KEY=
ADMIN_SESSION_SECRET=
ADMIN_PASSWORD_HASH=
IP_HASH_SALT=
